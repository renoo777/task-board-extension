{
  "manifest_version": 3,
  "name": "任务台",
  "version": "0.25.0",
  "key": "",
  "description": "点右上角图标即开的轻量任务台：今天聚焦、按项目组织、拖拽流转状态、任务可挂起，网页上常驻一颗悬浮球随手记，还能把任务台浮在桌面最上层。可镜像到飞书多维表格长期保存。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "alarms",
    "windows",
    "nativeMessaging",
    "notifications"
  ],
  "host_permissions": [
    "https://open.feishu.cn/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["mascot.js", "notify.js", "ballpage.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["mascots/*.webp", "mascots/thumb/*.webp"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "任务台（Ctrl+Shift+L）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "manage.html",
    "open_in_tab": true
  },
  "commands": {
    "quick-add": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "打开任务台"
    }
  }
}
